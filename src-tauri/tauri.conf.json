{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻画",
  "version": "0.1.17",
  "identifier": "com.qinghua.canvas",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:vite",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build && npm run prepare:ffmpeg"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "decorations": false,
        "visible": false,
        "title": "轻画",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https: asset: http://asset.localhost; media-src 'self' data: blob: http: https: asset: http://asset.localhost; font-src 'self' data: blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss: data: blob:; worker-src 'self' blob:; frame-src http: https:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/ffmpeg.exe": "resources/ffmpeg.exe",
      "resources/FFMPEG-LICENSE.txt": "resources/FFMPEG-LICENSE.txt",
      "resources/FFMPEG-NOTICE.txt": "resources/FFMPEG-NOTICE.txt",
      "resources/ffmpeg-build.json": "resources/ffmpeg-build.json",
      "resources/canvas-mcp.ps1": "resources/canvas-mcp.ps1",
      "../browser-extension/qinghua-clipper/": "resources/qinghua-clipper/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "endpoints": [
        "https://github.com/heyu1084916812/qinghua-canvas/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGODIxQjI1RTE5OEVDN0MKUldSODdKamhKUnVDdnpYejBXcXVlaTdubGVIRWRIQ1dZVkVOSWVvTUpzNlRtajBxM2JBMTRRMlgK"
    }
  }
}

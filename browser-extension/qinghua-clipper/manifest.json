{
  "manifest_version": 3,
  "name": "轻画 Clipper",
  "version": "0.4.6",
  "description": "拖动网页图片，自动收藏到本机轻画。",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:53684/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "轻画拖拽收藏",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}

{
  "manifest_version": 3,
  "name": "轻画 Clipper",
  "version": "0.3.0",
  "description": "收藏当前网页，或把网页图片拖进投放区，保存到本机轻画。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://127.0.0.1:53684/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "收藏到轻画",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "clip-active-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "收藏当前网页到轻画"
    }
  }
}
